import lombok.Builder;
import lombok.NoArgsConstructor;
import lombok.Data;
import java.util.List;
import jakarta.persistence.Entity;
@Data
@AllArgsConstructor
@NoArgsConstructor
@Builder
@Entity
public class Station {
    @Id
